# ============================================================================
# HeatShield AI — Full-Stack Production Environment Template
# ============================================================================

# ----------------------------------------------------------------------------
# FRONTEND (Vercel)
# ----------------------------------------------------------------------------
# Point to your production backend URL deployed on Railway or Render:
VITE_API_BASE_URL=https://your-heatshield-api.up.railway.app

# ----------------------------------------------------------------------------
# BACKEND (Railway / Render - Web Service with Persistent Background Worker)
# ----------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8001
HOST=0.0.0.0

# CORS: Set to your production Vercel frontend URL
FRONTEND_URL=https://your-heatshield-frontend.vercel.app
ADDITIONAL_CORS_ORIGINS=

# Database:
# Production PostgreSQL (Railway / Render managed Postgres):
# DATABASE_URL=postgresql://heatshield:password@postgres.railway.internal:5432/railway
# Local dev fallback: leave empty to use local SQLite (backend/data/heatshield.db)
DATABASE_URL=

# JWT Authentication:
JWT_SECRET_KEY=heatshield-ai-secure-jwt-production-token-secret-key-32chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Delivery (Resend API):
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=alerts@yourdomain.com

# AI Assistant (Optional):
GEMINI_API_KEY=
