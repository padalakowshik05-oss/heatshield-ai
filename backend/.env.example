# ============================================================================
# HeatShield AI — Backend Production Environment Configuration Template
# ============================================================================

# Environment Mode: 'production' for live deployments, 'development' for local work
ENVIRONMENT=production

# Server Port & Host (Automatically injected by Railway/Render as $PORT)
PORT=8001
HOST=0.0.0.0

# Frontend Allowed Origin (e.g. your Vercel deployment URL)
FRONTEND_URL=https://your-heatshield-frontend.vercel.app

# Additional comma-separated CORS origins (optional)
ADDITIONAL_CORS_ORIGINS=

# Database Connection URL:
# For production (PostgreSQL on Railway/Render/Neon/Supabase):
# DATABASE_URL=postgresql://heatshield:password@postgres.railway.internal:5432/railway
# For local development (leave unset to default to SQLite in backend/data/heatshield.db):
DATABASE_URL=

# JWT Authentication (generate a secure 32+ character random string for production)
JWT_SECRET_KEY=heatshield-ai-secure-jwt-production-token-secret-key-32chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Delivery Service (Resend API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender email address (use onboarding@resend.dev for testing, or your verified domain in production)
EMAIL_FROM=alerts@yourdomain.com

# AI Assistant (Optional: Gemini 1.5 Pro/Flash integration; falls back to grounded deterministic reasoning if omitted)
GEMINI_API_KEY=
